#!/bin/sh
# net-watchdog - uplink health recorder + auto-recovery for the campus uplink
#
# WHY THIS EXISTS
#   A wireless-uplink router (STA mode to the campus AP) can lose its DHCP
#   lease. With no WAN address there is no default route, so the router cannot
#   reach the portal at all - re-associating the AP does not help either, and
#   the uplink may only come back hours later. Campus DHCP leases can be short
#   (~2 h), so there are plenty of chances for a renewal to fail.
#
#   The syslog evidence gets destroyed in the process: a transparent-proxy
#   plugin (UA3F) floods syslog with "network is unreachable" while the uplink
#   is down, and the ring buffer only holds a few minutes of that. dmesg is not
#   useful either - wpa_supplicant events go to syslog, not to dmesg.
#
#   So this daemon keeps its OWN record and never relies on syslog:
#     * /tmp/net-watchdog.log      - every sample, RAM only, trimmed to 3000
#                                    lines (no flash wear, survives an outage,
#                                    lost only on reboot)
#     * /etc/net-watchdog.journal  - persistent. Written on every state change
#                                    and, while the state is bad, at most once
#                                    every 5 min. Tiny write volume.
#
# LIVENESS PROBE: HTTP, NOT ICMP  <-- changed after a real incident
#   Campus gateways commonly rate-limit or outright drop ICMP. Measured on one
#   campus uplink while everything worked perfectly:
#       TCP  (HTTP GET to the outside) : 6/6 OK
#       ICMP 114.114.114.114           : 100% packet loss
#       ICMP 223.5.5.5                 : 10% packet loss
#   A ping-based probe therefore reports "down" while the network is fine, and
#   acting on that false alarm made things much worse: a forced interface
#   bounce cost 11 minutes of downtime plus a radio restart that disconnected
#   the very client diagnosing the problem.
#   => The liveness probe is an HTTP GET. ICMP is not used at all.
#
# STATES
#   OK      : interface up + associated + IPv4 + default route + HTTP probe ok
#   IFDOWN  : netifd does not consider the interface up (or has no device)
#   NOLINK  : the uplink device is not associated / has no carrier
#   NOIP    : associated but no usable IPv4 address or no default route
#   NOHTTP  : everything present but the HTTP probe fails
#
# RECOVERY LADDER - strictly ONE action per sample
#   IFDOWN : >=60s  -> ubus network.interface.<if> up   (every 3 min)
#   NOLINK : >=120s -> iw dev <sta> disconnect          (every 5 min, wifi)
#   NOIP / NOHTTP   -> recorded only, deliberately no action
#
# WHY `renew` IS NOT IN THE LADDER
#   `ubus call network.interface.<if> renew` sends SIGUSR1 to udhcpc, which
#   forces the whole RENEWING -> REBINDING -> lease-lost sequence on a very
#   short fuse. Measured: 13 seconds of silence from the server and the lease
#   was torn down, even though 5000 s of it were left. A campus DHCP server
#   that is merely slow for a minute therefore turns into a full outage - and
#   both real outages on this router were caused by a forced renew, not by the
#   campus. Left alone, udhcpc keeps DISCOVERing (-t 0 = forever) and a
#   *scheduled* renewal has ~an hour of slack, so a slow server costs nothing.
#
#   Also NOT done automatically: `down`+`up` of the interface and
#   `wireless reconf`. Both restart the radio that carries the AP the clients
#   are associated to, so they disconnect the user who is trying to diagnose
#   the problem, and a bounce can leave the interface with no lease for many
#   minutes. They are opt-in via NET_WD_ALLOW_REBOUNCE=1 / config
#   netwatchdog.main.allow_rebounce.
#
#   All recovery commands run detached (setsid) so that a network
#   reconfigure can never kill this shell, and the shell can never be killed
#   by its own recovery action.
#
# Usage: net-watchdog {run|once|status|log|journal}
#   run     - daemon loop (used by procd)
#   once    - one sample, print it, refresh /tmp/net-watchdog.status
#   status  - print /tmp/net-watchdog.status
#   log     - print the RAM sample log
#   journal - print the persistent journal

. /lib/functions.sh
. /lib/functions/network.sh

TAG="net-watchdog"

# --- configuration ---------------------------------------------------------
# Normal settings are shared with campus-auth so there is only one place to
# edit. Everything below can be overridden from the environment, which is how
# the recovery ladder gets drilled without touching the real uplink:
#
#   NET_WD_SUFFIX=-test   use separate log/journal/status files
#   NET_WD_DRY=1          log the actions but do not execute them
#   NET_WD_INTERVAL=5     sampling interval in seconds
#   NET_WD_IFACE=wan      watch a different interface
#   NET_WD_T_UP / T_REASSOC / T_BOUNCE
#   NET_WD_CD_UP / CD_REASSOC / CD_BOUNCE
#   NET_WD_ALLOW_REBOUNCE=1  enable the disruptive down/up last resort
#
SUFFIX="${NET_WD_SUFFIX:-}"
LOG="/tmp/net-watchdog$SUFFIX.log"
JOURNAL="/etc/net-watchdog$SUFFIX.journal"
STATUS="/tmp/net-watchdog$SUFFIX.status"
MAXLOG=3000

INTERVAL="${NET_WD_INTERVAL:-30}"
DRY="${NET_WD_DRY:-0}"

T_UP="${NET_WD_T_UP:-60}"
T_REASSOC="${NET_WD_T_REASSOC:-120}"
T_BOUNCE="${NET_WD_T_BOUNCE:-1800}"

CD_UP="${NET_WD_CD_UP:-180}"
CD_REASSOC="${NET_WD_CD_REASSOC:-300}"
CD_BOUNCE="${NET_WD_CD_BOUNCE:-1800}"

IFACE="${NET_WD_IFACE:-$(uci -q get campusauth.main.iface)}"
[ -z "$IFACE" ] && IFACE="wwan"

# External HTTP endpoint used as the liveness probe. ICMP is deliberately not
# used (see the header). Pick something small and reliable in your region.
PROBE_URL="${NET_WD_PROBE_URL:-$(uci -q get campusauth.main.probe_url)}"
[ -z "$PROBE_URL" ] && PROBE_URL="http://www.baidu.com/"

# Portal address: informational only (tells "campus only" apart from "nothing").
PORTAL=$(uci -q get campusauth.main.server)

# Interface bounce / wireless reconf are disruptive; opt in explicitly.
ALLOW_REBOUNCE="${NET_WD_ALLOW_REBOUNCE:-$(uci -q get netwatchdog.main.allow_rebounce)}"
[ "$ALLOW_REBOUNCE" = "1" ] || ALLOW_REBOUNCE=0

log() { logger -p user.notice -t "$TAG" "$*"; }

# Run a command detached from our process group. A network reconfigure must
# never be able to take this daemon down, and vice versa. In DRY mode the
# action is only logged.
bg() {
    if [ "$DRY" = "1" ]; then
        log "DRY-RUN would run: $1"
        return 0
    fi
    setsid sh -c "$1" >/dev/null 2>&1 &
}

# --- sampling -------------------------------------------------------------
# Sets the STAT_* globals (sample() must not run in a subshell).
STAT_DEV=""; STAT_IP=""; STAT_GW=""; STAT_AS="-"; STAT_HTTP="-"; STAT_PRTL="-"
STAT_ST=""; STAT_WIFI=0; STAT_UP=0

sample() {
    local j dev ip gw

    STAT_HTTP="-"; STAT_PRTL="-"; STAT_WIFI=0; STAT_UP=0

    # --- interface state straight from netifd ------------------------------
    j=$(ubus call network.interface."$IFACE" status 2>/dev/null | tr -d ' \t\n')
    case "$j" in *'"up":true'*) STAT_UP=1 ;; esac

    dev=$(printf '%s' "$j" | sed -n 's/.*"l3_device":"\([^"]*\)".*/\1/p')
    [ -z "$dev" ] && dev=$(uci -q get "network.${IFACE}.device")

    ip=$(printf '%s' "$j" | sed -n 's/.*"ipv4-address":\[{"address":"\([0-9.]*\)".*/\1/p')

    # Cross-check against the kernel: netifd can still report an address for an
    # interface that has just gone down, which produced confusing samples
    # ("ip=10.99.x.x dev=-").
    if [ -n "$ip" ] && [ -n "$dev" ]; then
        ip -4 addr show dev "$dev" 2>/dev/null | grep -q "inet $ip/" || ip=""
    fi
    [ -n "$ip" ] || ip=""
    case "$ip" in 127.*) ip="" ;; esac

    # The default route must belong to *this* uplink. `ip route show default`
    # without a device filter happily reports another interface's gateway.
    if [ -n "$dev" ]; then
        gw=$(ip -4 route show default dev "$dev" 2>/dev/null |
             sed -n 's/.*via \([0-9.]*\).*/\1/p' | head -1)
    else
        gw=""
    fi

    # --- association / carrier --------------------------------------------
    STAT_AS="-"
    if [ -n "$dev" ] && [ -d "/sys/class/net/$dev/wireless" ]; then
        STAT_WIFI=1
        if iw dev "$dev" link 2>/dev/null | grep -q 'Connected'; then
            STAT_AS=1
        else
            STAT_AS=0
        fi
    elif [ -n "$dev" ] && [ -r "/sys/class/net/$dev/carrier" ]; then
        STAT_AS=$(cat "/sys/class/net/$dev/carrier" 2>/dev/null)
    fi

    STAT_DEV="$dev"; STAT_IP="$ip"; STAT_GW="$gw"

    # --- state -------------------------------------------------------------
    if [ -z "$dev" ] || [ "$STAT_UP" != "1" ]; then
        STAT_ST="IFDOWN"
    elif [ "$STAT_AS" = "0" ]; then
        STAT_ST="NOLINK"
    elif [ -z "$ip" ] || [ -z "$gw" ]; then
        STAT_ST="NOIP"
    elif probe_http; then
        STAT_HTTP=1
        STAT_ST="OK"
    else
        STAT_HTTP=0
        STAT_ST="NOHTTP"
    fi
}

# Liveness = can we actually fetch something over TCP?
probe_http() {
    wget -q -O /dev/null -T 5 "$PROBE_URL" >/dev/null 2>&1
}

# Portal reachability - informational, and only while something is wrong, so
# that "the campus is fine but the outside is not" can be told apart from
# "nothing works". Skipped when no portal address is configured.
probe_portal() {
    [ -z "$PORTAL" ] && { STAT_PRTL="-"; return 0; }
    if wget -q -O /dev/null -T 4 "http://$PORTAL/" >/dev/null 2>&1; then
        STAT_PRTL=1
    else
        STAT_PRTL=0
    fi
}

line() {
    printf '%s iface=%s dev=%s up=%s ip=%s gw=%s as=%s http=%s prtl=%s st=%s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" "$IFACE" \
        "${STAT_DEV:--}" "$STAT_UP" "${STAT_IP:--}" "${STAT_GW:--}" \
        "$STAT_AS" "$STAT_HTTP" "$STAT_PRTL" "$STAT_ST"
}

write_status() {
    local since="$1" actions=0
    [ -f "$JOURNAL" ] && actions=$(grep -c 'ACTION' "$JOURNAL" 2>/dev/null)
    cat > "$STATUS" <<EOF
state=$STAT_ST
iface=$IFACE
device=${STAT_DEV:--}
iface_up=$STAT_UP
ip=${STAT_IP:--}
gateway=${STAT_GW:--}
associated=$STAT_AS
probe=${STAT_HTTP}
portal=${STAT_PRTL}
probe_url=$PROBE_URL
down_for=${since}
actions=${actions:-0}
rebounce=${ALLOW_REBOUNCE}
updated=$(date '+%Y-%m-%d %H:%M:%S')
EOF
}

act() {
    printf '%s ACTION: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$JOURNAL"
    log "ACTION: $*"
}

trim_log() {
    [ "$(wc -l < "$LOG" 2>/dev/null)" -gt "$MAXLOG" ] || return 0
    tail -n "$MAXLOG" "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG"
}

trim_journal() {
    [ "$(wc -c < "$JOURNAL" 2>/dev/null)" -gt 200000 ] || return 0
    tail -n 500 "$JOURNAL" > "$JOURNAL.tmp" 2>/dev/null && mv "$JOURNAL.tmp" "$JOURNAL"
}

do_once() {
    sample
    [ "$STAT_ST" != "OK" ] && probe_portal
    line
    write_status 0
}

do_run() {
    local cycle=0 since_ok=0 last_st="" last_j=0
    local last_up=0 last_reassoc=0 last_bounce=0
    local now l extra st

    trim_journal
    log "started (iface=$IFACE interval=${INTERVAL}s probe=$PROBE_URL dry=$DRY rebounce=$ALLOW_REBOUNCE)"

    # give the network a moment to settle after boot
    sleep "${NET_WD_SETTLE:-20}"

    while true; do
        cycle=$((cycle + 1))
        sample
        now=$(date +%s)
        st="$STAT_ST"

        # extra probes only when something is wrong, and not every cycle
        if [ "$st" != "OK" ] && [ $((cycle % 4)) -eq 0 ]; then
            probe_portal
        fi

        l=$(line)
        echo "$l" >> "$LOG"
        [ $((cycle % 20)) -eq 0 ] && trim_log

        if [ "$st" = "OK" ]; then
            since_ok=0
        else
            since_ok=$((since_ok + INTERVAL))
        fi

        # persistent journal: every transition, plus a 5-minute heartbeat
        extra=""
        if [ "$st" != "$last_st" ] && [ -n "$last_st" ]; then
            extra=" [${last_st}->${st}]"
        fi
        if [ -n "$extra" ]; then
            echo "$l$extra" >> "$JOURNAL"
            log "state ${last_st:-init} -> $st (up=$STAT_UP ip=${STAT_IP:--} gw=${STAT_GW:--} as=$STAT_AS)"
            last_j=$now
        elif [ "$st" != "OK" ] && [ $((now - last_j)) -ge 300 ]; then
            echo "$l" >> "$JOURNAL"
            last_j=$now
        fi
        last_st="$st"

        # --- recovery ladder: exactly ONE action per sample ----------------
        #
        # `ubus call network.interface.<if> renew` is deliberately NOT used.
        # It sends SIGUSR1 to udhcpc, which forces the whole
        # RENEWING -> REBINDING -> lease-lost sequence on a very short fuse
        # (observed: 21s -> 34s, i.e. 13 seconds of silence from the server and
        # the lease is torn down, even with 5000s of lease time left). A campus
        # DHCP server that is merely slow for a minute then turns into a full
        # outage. Left alone, udhcpc follows its own schedule and a scheduled
        # renewal has ~an hour of slack before the lease actually expires.
        # Both real outages on this router were triggered by a forced renew,
        # so the ladder only contains actions that cannot cost the lease.
        case "$st" in
            IFDOWN)
                if [ "$since_ok" -ge "$T_UP" ] && [ $((now - last_up)) -ge "$CD_UP" ]; then
                    last_up=$now
                    bg "ubus call network.interface.$IFACE up"
                    act "bring up $IFACE (netifd reports it down for ${since_ok}s)"
                fi
                ;;
            NOLINK)
                if [ "$since_ok" -ge "$T_REASSOC" ] && [ $((now - last_reassoc)) -ge "$CD_REASSOC" ] &&
                   [ "$STAT_WIFI" = "1" ] && [ -n "$STAT_DEV" ]; then
                    last_reassoc=$now
                    bg "iw dev $STAT_DEV disconnect"
                    act "force reassociation on $STAT_DEV (link down for ${since_ok}s)"
                fi
                ;;
            NOIP)
                # Interface is up but has no address: udhcpc was started with
                # `-t 0` and keeps sending DISCOVERs forever, so it recovers by
                # itself once the server answers. Do not touch the lease.
                :
                ;;
            NOHTTP)
                # Address and route are fine but nothing can be fetched; that is
                # the campus session or something upstream, not the uplink.
                :
                ;;
        esac

        # Disruptive last resort, disabled unless explicitly enabled: it takes
        # down the radio the local AP lives on.
        if [ "$ALLOW_REBOUNCE" = "1" ] && [ "$since_ok" -ge "$T_BOUNCE" ] &&
           [ $((now - last_bounce)) -ge "$CD_BOUNCE" ]; then
            last_bounce=$now
            bg "sleep 1; ubus call network.interface.$IFACE down; sleep 3; ubus call network.interface.$IFACE up"
            act "bounce $IFACE (uplink unusable for ${since_ok}s)"
        fi

        write_status "$since_ok"
        sleep "$INTERVAL"
    done
}

case "$1" in
    run)     do_run ;;
    once)    do_once ;;
    status)  cat "$STATUS" 2>/dev/null || echo "state=unknown" ;;
    log)     tail -n 200 "$LOG" 2>/dev/null ;;
    journal) tail -n 200 "$JOURNAL" 2>/dev/null ;;
    *)       echo "Usage: $0 {run|once|status|log|journal}"; exit 1 ;;
esac
exit 0
